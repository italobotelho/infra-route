# ==============================================================================
# InfraRoute — Exemplo de Variáveis de Ambiente (.env.example)
# Copie este arquivo para .env ou .env.local na raiz do projeto.
# ATENÇÃO (Aula 05): Nunca versionar arquivos .env reais com segredos no Git!
# ==============================================================================

# 1. Frontend (Vite + Google Maps JavaScript API com fallback automático Leaflet/OSM)
VITE_GOOGLE_MAPS_API_KEY=SUA_CHAVE_AQUI
VITE_API_BASE_URL=/api
VITE_API_PROXY_TARGET=http://127.0.0.1:8000

# 2. Backend (FastAPI + Segurança JWT HS256 / Bcrypt / Rate Limiting)
APP_ENV=development
JWT_SECRET_KEY=TROQUE_POR_UMA_CHAVE_SECRETA_FORTE_HS256
JWT_EXPIRATION_SECONDS=28800
BCRYPT_ROUNDS=12
AUTH_MAX_ATTEMPTS=5
AUTH_LOCKOUT_SECONDS=900
OTP_EXPIRATION_SECONDS=600
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:8000,http://127.0.0.1:8000

# 3. Banco de Dados Oficial (PostgreSQL + PostGIS) e Fallback Local (SQLite ACID)
# Utilize "postgresql" quando conectar a um servidor PostgreSQL + PostGIS ativo (via DATABASE_URL),
# ou "sqlite" como fallback local sem servidor externo.
DB_ENGINE=sqlite
SQLITE_DB_PATH=.cache/infraroute.db
DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/infraroute

# 4. Docker Compose (PostgreSQL + PostGIS + pgRouting)
# Usadas automaticamente pelo docker-compose.yml (com fallback para esses mesmos padrões).
POSTGRES_DB=infraroute
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

# 5. Validação de CREA (Local Estrutural + Provedor Externo Opcional)
# Use "local" (padrão) para validação estrutural/UF offline, ou "http" com uma API externa.
CREA_VALIDATION_PROVIDER=local
CREA_API_URL=
CREA_API_TOKEN=
CREA_API_TIMEOUT_SECONDS=5.0
CREA_API_STRICT_MODE=false
CREA_CACHE_TTL_SECONDS=900
